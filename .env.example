# 复制为 .env，选择一项：openai、anthropic、deepseek、kimi 或 custom。
MODEL_PROVIDER=openai

# 各服务商分别使用自己的密钥。只填写所选服务商一组。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_REASONING_EFFORT=xhigh

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 仅当官方密钥要求指定工作区时填写
ANTHROPIC_WORKSPACE_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3.1-pro

# 第三方或本机服务。接口格式：chat（Chat Completions）或 anthropic（Claude Messages）。
# 示例：http://127.0.0.1:1234/v1
CUSTOM_BASE_URL=
CUSTOM_API_FORMAT=chat
CUSTOM_MODEL=
CUSTOM_API_KEY=
