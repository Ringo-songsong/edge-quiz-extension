# 复制为 .env，选择一项：openai、deepseek、kimi 或 custom。
MODEL_PROVIDER=openai

# 各服务商分别使用自己的密钥。只填写所选服务商一组。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_REASONING_EFFORT=xhigh

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3.1-pro

# 兼容 Chat Completions 的第三方接口或本机服务。
# 示例：http://127.0.0.1:1234/v1
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=
